{
  "name": "@rpe/app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema=prisma/moodle.prisma && prisma generate --schema=prisma/glpi.prisma && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/moodle.prisma && prisma generate --schema=prisma/glpi.prisma",
    "db:push:moodle": "prisma db push --schema=prisma/moodle.prisma",
    "db:push:glpi": "prisma db push --schema=prisma/glpi.prisma",
    "db:seed:moodle": "tsx prisma/moodle-seed.ts",
    "db:seed:glpi": "tsx prisma/glpi-seed.ts"
  },
  "dependencies": {
    "@rpe/domain-kit": "workspace:*",
    "@rpe/plugin-sdk": "workspace:*",
    "@rpe/platform-kit": "workspace:*",
    "@rpe/moodle-core": "workspace:*",
    "@rpe/glpi-core": "workspace:*",
    "@rpe/mod-page": "workspace:*",
    "@rpe/mod-video": "workspace:*",
    "@rpe/mod-url": "workspace:*",
    "@rpe/asset-computer": "workspace:*",
    "@rpe/asset-network": "workspace:*",
    "@rpe/asset-printer": "workspace:*",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
